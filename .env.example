DOMAIN=localhost
ENTRYPOINT=websecure
TLS_ENABLED=true
CERT_RESOLVER=myresolver
TRAEFIK_API_INSECURE=false

# Telegram Bot Config
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_ALLOWED_USERS=12345678,987654321

# Database (Shared by Backend and Bot)
MAIN_DB_USER=root
MAIN_DB_PASSWORD=your-super-secret-password
MAIN_DB_NAME=main_db
MAIN_DB_HOST=main-db
MAIN_DB_PORT=5432

# Cache
CACHE_HOST=valkey
CACHE_PORT=6379
CACHE_PASSWORD=your-super-secret-password

# Application Paths
STORAGE_URL=http://localhost/storage

# Twenty CRM Config
SERVER_URL=http://crm.localhost
PG_DATABASE_USER=twenty
PG_DATABASE_PASSWORD=twenty_password_change_me
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default

REDIS_URL=redis://password@valkey:6379

ENCRYPTION_KEY=generate_a_64_char_hex_string_here
FALLBACK_ENCRYPTION_KEY=generate_another_64_char_hex_string_here
APP_SECRET=generate_a_random_string_here

# Twenty Storage
STORAGE_TYPE=local
# If using S3:
# STORAGE_TYPE=s3
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_NAME=my-bucket
# STORAGE_S3_ENDPOINT=http://minio:9000

# Twenty Maintenance
DISABLE_DB_MIGRATIONS=false
DISABLE_CRON_JOBS_REGISTRATION=false

TWENTY_REST_URL=http://server:3000/rest
TWENTY_API_KEY=your_api_key_here
