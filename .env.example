DOMAIN=localhost
ENTRYPOINT=websecure
TLS_ENABLED=true
CERT_RESOLVER=myresolver
TRAEFIK_API_INSECURE=false

# ── Frontend (Next.js) ────────────────────────────────────────────
# These are inlined at BUILD time (Next.js only exposes NEXT_PUBLIC_* to the
# client bundle). Changing them requires rebuilding the website image.
#   NEXT_PUBLIC_ROOT_DOMAIN  the bare hostname (no scheme, no port) that
#                            app.*/admin.*/i.* hang off. The auth cookie is
#                            scoped to ".{this value}" so every subdomain can
#                            read it. MUST match the hostname you serve the
#                            root site on.
#   NEXT_PUBLIC_PROTOCOL     "http" in local dev, "https" in prod. When empty
#                            it is inferred from the current page.
#   NEXT_PUBLIC_API_BASE_URL full URL of the FastAPI backend. XHRs from every
#                            subdomain hit this.
NEXT_PUBLIC_ROOT_DOMAIN=rovno.dev
NEXT_PUBLIC_PROTOCOL=https
NEXT_PUBLIC_API_BASE_URL=https://rovno.dev

# Debug flag: set to 1 to log every cookie read/write in the browser console.
# NEXT_PUBLIC_DEBUG_AUTH=1

# ── Backend CORS ──────────────────────────────────────────────────
# Accepts exact origins and wildcards. "*" inside a host segment expands to
# any subdomain. Keep the exact root too so the API is callable from the
# bare domain.
ALLOWED_ORIGINS=https://rovno.dev,https://*.rovno.dev

# ── Telegram ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_ALLOWED_USERS=12345678,987654321

# ── Database ──────────────────────────────────────────────────────
MAIN_DB_USER=root
MAIN_DB_PASSWORD=your-super-secret-password
MAIN_DB_NAME=main_db
MAIN_DB_HOST=main-db
MAIN_DB_PORT=5432

# ── Cache ─────────────────────────────────────────────────────────
CACHE_HOST=valkey
CACHE_PORT=6379
CACHE_PASSWORD=your-super-secret-password

STORAGE_URL=http://localhost/storage

# ── Auth ──────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Mail ──────────────────────────────────────────────────────────
MAIL_SENDER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# ── Admin subdomain gate ─────────────────────────────────────────
# Shared path segment that must appear as the first path element on admin.*
# (e.g. https://admin.rovno.dev/<ADMIN_SECRET_URI>/users).
ADMIN_SECRET_URI=change-me
