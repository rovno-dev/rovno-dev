# Copy this file and lock it down:
#
#   cp backup/.env.example backup/.env
#   chmod 600 backup/.env
#
# NEVER commit backup/.env. It contains the keys to every backup.

# ---------------------------------------------------------------------------
# Destination: any S3-compatible bucket
# ---------------------------------------------------------------------------
# The bucket must already exist and be private. Restic needs read, write,
# list, and delete (delete is used by retention/prune).
#
# AWS S3:                 s3:s3.amazonaws.com/rovno-backups
# Yandex Object Storage:  s3:https://storage.yandexcloud.net/rovno-backups
# Cloudflare R2:          s3:https://<account-id>.r2.cloudflarestorage.com/rovno-backups
# Backblaze B2:           s3:https://s3.<region>.backblazeb2.com/rovno-backups
# MinIO:                  s3:http://minio:9000/rovno-backups
RESTIC_REPOSITORY=

# Dedicated bucket-scoped credentials. Do not reuse application keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-central-1
# Cloudflare R2 uses: AWS_DEFAULT_REGION=auto

# ---------------------------------------------------------------------------
# Encryption
# ---------------------------------------------------------------------------
# Restic encrypts the repository client-side. Without this password the
# backups are unrecoverable, including by whoever owns the bucket.
#
# Generate once:  openssl rand -base64 48
# Store a copy in a password manager and/or an offline vault. Do NOT keep
# the only copy on this server.
RESTIC_PASSWORD=

# ---------------------------------------------------------------------------
# Schedule (UTC) and retention
# ---------------------------------------------------------------------------
# First backup runs on container start when BACKUP_ON_START=true. After that,
# a backup runs every day at BACKUP_HOUR:BACKUP_MINUTE UTC.
BACKUP_ON_START=true
BACKUP_HOUR=3
BACKUP_MINUTE=15

# Optional fixed interval instead of the daily clock (seconds). Leave at
# 86400 to use BACKUP_HOUR/BACKUP_MINUTE. Example: 21600 = every 6 hours.
BACKUP_INTERVAL_SECONDS=86400

# Retention. One of each kept in addition to the daily set.
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
KEEP_YEARLY=1

# Run `restic prune` after forgetting old snapshots. Set this to false if the
# bucket enforces Object Lock and rejects deletes; use a lifecycle rule for
# old data instead.
BACKUP_PRUNE=true

# Verify the repository after each backup. Without CHECK_READ_DATA_SUBSET
# this only checks metadata. "2%" downloads and verifies a sample of pack
# files; keep it small to control egress cost.
BACKUP_CHECK=true
CHECK_READ_DATA_SUBSET=2%

# Wait this long for main-db on a cold start before failing the run.
DB_WAIT_SECONDS=300

# Retry a failed scheduled backup once after this delay (seconds).
BACKUP_RETRY_SECONDS=900

# ---------------------------------------------------------------------------
# What to back up (container paths; normally leave these alone)
# ---------------------------------------------------------------------------
MEDIA_PATHS="/media/backend /media/website-public"
CONFIG_PATHS="/config/app.env /config/website.env /config/letsencrypt"

# ---------------------------------------------------------------------------
# Optional failure alerts (Telegram)
# ---------------------------------------------------------------------------
# Create a bot with @BotFather, start a chat with it, and put the chat id
# here. Leave the token empty to disable alerts.
BACKUP_ALERT_TELEGRAM_TOKEN=
BACKUP_ALERT_TELEGRAM_CHAT_ID=
BACKUP_NOTIFY_SUCCESS=false
